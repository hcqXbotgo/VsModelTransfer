# Python/editor caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.idea/
.vscode/
.DS_Store

# Local environments and logs
.venv/
venv/
env.sh
*.log

# Models and compiler binaries are kept locally, not in regular Git.
*.onnx
*.mgz

# Downloaded archives
*.zip
*.tar
*.tar.gz

# Locally downloaded/extracted toolchains (large binaries, not for Git)
dependencies/

# Reproducible quantization/evaluation/compile outputs.
modes/*/outputs/**
!modes/*/outputs/**/
!modes/*/outputs/**/.gitkeep

# Generated reports and tabular metrics
modes/*/datasets/reports/**
!modes/*/datasets/reports/.gitkeep
*.csv

# Calibration images are local data, not tracked in Git.
modes/*/datasets/calibration/images/**
!modes/*/datasets/calibration/images/.gitkeep
